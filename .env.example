# Copy this file to .env for local development.
# In production (Render), set these as environment variables instead —
# never commit a real .env file.

# Local development: True. Production: must be False (or unset).
DEBUG=True

# Required in production. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-key

# Comma-separated. Example for production: yourapp.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated, must include the scheme. Example: https://yourapp.onrender.com
CSRF_TRUSTED_ORIGINS=

# Provided automatically by Render when you attach a Postgres database.
# Leave unset locally to fall back to SQLite.
DATABASE_URL=

# Cloudinary (product image storage). Leave all three empty locally to use
# the filesystem instead. Required in production — create a free account at
# https://cloudinary.com and copy these from your dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
